set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 172.16.11.1/31
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 172.16.21.1/31
set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.0.1.1/32

set / interface lo1 admin-state enable
set / interface lo1 subinterface 0 ipv4 admin-state enable
set / interface lo1 subinterface 0 ipv4 address 12.12.12.12/32

set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface system0.0
set / network-instance default interface lo1.0

set / interface ethernet-1/10 admin-state enable
set / interface ethernet-1/10 ethernet aggregate-id lag1
set / interface lag1 admin-state enable
set / interface lag1 vlan-tagging true
set / interface lag1 lag lag-type lacp
set / interface lag1 lag lacp interval FAST
set / interface lag1 lag lacp lacp-mode ACTIVE
set / interface lag1 lag lacp admin-key 11
set / interface lag1 lag lacp system-id-mac 00:00:00:00:00:11
set / interface lag1 lag lacp system-priority 11
set / interface lag1 subinterface 0 type bridged
set / interface lag1 subinterface 0 vlan encap untagged

set / routing-policy prefix-set LOOPBACKS prefix 10.0.0.0/16 mask-length-range 32..32
set / routing-policy prefix-set LOOPBACKS prefix 12.12.12.12/32 mask-length-range exact
set / routing-policy policy UNDERLAY default-action policy-result reject
set / routing-policy policy UNDERLAY statement 10 match prefix prefix-set LOOPBACKS
set / routing-policy policy UNDERLAY statement 10 action policy-result accept

set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system 65001
set / network-instance default protocols bgp router-id 10.0.1.1
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath ebgp maximum-paths 8
set / network-instance default protocols bgp afi-safi evpn admin-state enable

set / network-instance default protocols bgp group underlay import-policy [ UNDERLAY ]
set / network-instance default protocols bgp group underlay export-policy [ UNDERLAY ]
set / network-instance default protocols bgp group underlay afi-safi evpn admin-state disable
set / network-instance default protocols bgp neighbor 172.16.11.0 peer-group underlay
set / network-instance default protocols bgp neighbor 172.16.11.0 peer-as 65100
set / network-instance default protocols bgp neighbor 172.16.21.0 peer-group underlay
set / network-instance default protocols bgp neighbor 172.16.21.0 peer-as 65100

set / network-instance default protocols bgp group overlay peer-as 65500
set / network-instance default protocols bgp group overlay local-as as-number 65500
set / network-instance default protocols bgp group overlay afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group overlay afi-safi evpn admin-state enable
set / network-instance default protocols bgp group overlay transport local-address 10.0.1.1
set / network-instance default protocols bgp neighbor 10.0.0.1 peer-group overlay
set / network-instance default protocols bgp neighbor 10.0.0.2 peer-group overlay

set / tunnel-interface vxlan1 vxlan-interface 100 type bridged
set / tunnel-interface vxlan1 vxlan-interface 100 ingress vni 100

set / network-instance mac-vrf-100 type mac-vrf
set / network-instance mac-vrf-100 admin-state enable
set / network-instance mac-vrf-100 interface lag1.0
set / network-instance mac-vrf-100 vxlan-interface vxlan1.100
set / network-instance mac-vrf-100 protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance mac-vrf-100 protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.100
set / network-instance mac-vrf-100 protocols bgp-evpn bgp-instance 1 evi 100
set / network-instance mac-vrf-100 protocols bgp-evpn bgp-instance 1 ecmp 8
set / network-instance mac-vrf-100 protocols bgp-vpn bgp-instance 1 route-target export-rt target:65500:100
set / network-instance mac-vrf-100 protocols bgp-vpn bgp-instance 1 route-target import-rt target:65500:100

set / system network-instance protocols bgp-vpn bgp-instance 1
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 admin-state enable
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 esi 00:11:11:11:11:11:11:00:00:01
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 multi-homing-mode all-active
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 type none
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 interface lag1
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 anycast-multi-homing ip-address 12.12.12.12
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 df-election algorithm type preference
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 df-election algorithm preference-alg preference-value 200
set / system network-instance protocols evpn ethernet-segments bgp-instance 1 ethernet-segment ES-1 df-election algorithm preference-alg capabilities ac-df exclude
