set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 172.16.21.0/31
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 172.16.22.0/31
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 172.16.23.0/31
set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.0.0.2/32

set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface ethernet-1/3.0
set / network-instance default interface system0.0

set / routing-policy prefix-set LOOPBACKS prefix 10.0.0.0/16 mask-length-range 32..32
set / routing-policy prefix-set LOOPBACKS prefix 12.12.12.12/32 mask-length-range exact
set / routing-policy policy UNDERLAY default-action policy-result reject
set / routing-policy policy UNDERLAY statement 10 match prefix prefix-set LOOPBACKS
set / routing-policy policy UNDERLAY statement 10 action policy-result accept

set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system 65100
set / network-instance default protocols bgp router-id 10.0.0.2
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath ebgp maximum-paths 8
set / network-instance default protocols bgp afi-safi evpn admin-state enable

set / network-instance default protocols bgp group underlay import-policy [ UNDERLAY ]
set / network-instance default protocols bgp group underlay export-policy [ UNDERLAY ]
set / network-instance default protocols bgp group underlay afi-safi evpn admin-state disable
set / network-instance default protocols bgp neighbor 172.16.21.1 peer-group underlay
set / network-instance default protocols bgp neighbor 172.16.21.1 peer-as 65001
set / network-instance default protocols bgp neighbor 172.16.22.1 peer-group underlay
set / network-instance default protocols bgp neighbor 172.16.22.1 peer-as 65002
set / network-instance default protocols bgp neighbor 172.16.23.1 peer-group underlay
set / network-instance default protocols bgp neighbor 172.16.23.1 peer-as 65003

set / network-instance default protocols bgp group overlay peer-as 65500
set / network-instance default protocols bgp group overlay local-as as-number 65500
set / network-instance default protocols bgp group overlay afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group overlay afi-safi evpn admin-state enable
set / network-instance default protocols bgp group overlay route-reflector client true
set / network-instance default protocols bgp group overlay route-reflector cluster-id 10.0.0.2
set / network-instance default protocols bgp group overlay transport local-address 10.0.0.2
set / network-instance default protocols bgp neighbor 10.0.1.1 peer-group overlay
set / network-instance default protocols bgp neighbor 10.0.1.2 peer-group overlay
set / network-instance default protocols bgp neighbor 10.0.1.3 peer-group overlay
